{
  "name": "autopilot-codex",
  "version": "1.0.0",
  "description": "Smart autopilot for Codex with AI-powered contextual responses",
  "main": "electron.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "build": "electron-builder --mac"
  },
  "build": {
    "appId": "com.autopilot-codex.app",
    "productName": "Autopilot Codex",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "icon": "icon.icns"
    },
    "files": [
      "electron.js",
      "index.html",
      "server.js",
      "send_to_codex.py",
      "brain-worker.js",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "knowledge",
        "to": "knowledge"
      },
      {
        "from": "send_to_codex.py",
        "to": "send_to_codex.py"
      }
    ]
  },
  "dependencies": {
    "sharp": "^0.34.5",
    "ws": "^8.18.0"
  },
  "keywords": ["codex", "autopilot", "ai", "agent"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  }
}
